# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Logs and PID files
*.log
*.pid
pipeline_run.log
progress_check.log
auto_check.log
putnambench_run.log

# Results - only exclude logs and temporary files
results/run_*/inference.log
results/run_*/compile.log
results/run_*/summary.log
results/test_*/
results/run_*/compile.pid
results/run_*/inference.pid
results/run_*/lean_files/
results/run_*/summary_*/

# Temporary files
*.bak
*.bak2
*.old
*.tmp
*~

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Model files (too large for git)
model_8B/

# Lean build artifacts
.lake/
*.olean
*.ilean

# Large data files - exclude all JSON except specific ones
*.json
!goedelv2.yml
!lake-manifest.json
!dataset/*.jsonl
!results/run_*/*.json
# Exclude very large result JSONs (would exceed GitHub 100MB limit)
results/run_*/full_records.json
results/run_*/to_inference_codes.json
results/run_*/code_compilation_repl.json
